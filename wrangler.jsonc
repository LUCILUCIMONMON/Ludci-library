{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lucimon-library",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-17",
  "account_id": "0fd3d23494eec3b1cb2c13ebbc099634",
  "assets": {
    "directory": "./src",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/article/*",
      "/admin*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lucimonlibrary",
      "database_id": "659e34f6-162d-4385-b299-cd25f47da788",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "lucimon-library-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
