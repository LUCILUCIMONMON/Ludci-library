{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ludci-library",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-17",
  "account_id": "0fd3d23494eec3b1cb2c13ebbc099634",
  "vars": {
    "PUBLIC_SITE_URL": "https://ludci-library.ibraiking97windows.workers.dev",
    "ADMIN_EMAIL": "ibraiking97windows@gmail.com"
  },
  "assets": {
    "directory": "./src",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/article/*",
      "/attribute/*",
      "/sitemap.xml",
      "/robots.txt",
      "/guide",
      "/admin*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lucimonlibrary",
      "database_id": "659e34f6-162d-4385-b299-cd25f47da788",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
